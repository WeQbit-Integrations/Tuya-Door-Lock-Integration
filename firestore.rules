rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /visitorAccess/{document} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
    match /oneTimeAccess/{document} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
  }
}